  "idea": {
    "title": "Golden Test Film",
    "idea": "En 60 sekunders mockumentary om Sander, en dansk håndværker, der altid bliver afbrudt af kunder.",
    "message": "Sander er en helt almindelig håndværker, men hans arbejdsdag går aldrig som planlagt.",
    "audience": "Danske håndværkere og deres kunder",
    "feeling": "Genkendelse og et smil",
    "duration": 60,
    "style": "Mockumentary",
    "shots": 12
  },
  "brief": {
    "logline": "En tømrer skal bare lige skifte et dørhængsel — ti minutter — men kunderne har andre planer.",
    "message": "Sander er en helt almindelig håndværker, men hans arbejdsdag udvikler sig altid anderledes end planlagt.",
    "audience": "Danske håndværkere og deres kunder",
    "feeling": "Genkendelse og et smil",
    "duration": 60,
    "style": "Mockumentary",
    "tone": "Tør, lun humor. Sander taler direkte til kameraet.",
    "moments": [
      "Sander lover: ti minutter",
      "Telefonen ringer — det er Fru Holm",
      "Fru Holms liste vokser",
      "Sander i varevognen om aftenen: \"Ti minutter.\""
    ],
    "questions": [
      "Skal Sander have en kollega med? Jeg har valgt nej, så han står alene med kunderne."
    ]
  },
  "film_dna": {
    "Genre": "Observerende mockumentary",
    "Visuelt sprog": "Naturalistisk dokumentar",
    "Kamera": "Håndholdt, optisk zoom, en operatør der ikke altid rammer perfekt",
    "Lys": "Naturligt, tilgængeligt lys",
    "Spil": "Underspillet",
    "Farver": "Kølig dagslysambient, varme praktiske lyskilder",
    "Tekstur": "Naturlig hud, slidt stof, ægte snavs",
    "Klipning": "Minimal og observerende"
  },
  "film_rules": [
    {
      "id": "r1",
      "text": "Ingen droneoptagelser",
      "kw": "drone\\w*|luftfoto\\w*|fugleperspektiv",
      "why": "filmen er filmet af én person med et håndholdt kamera"
    },
    {
      "id": "r2",
      "text": "Ingen overdrevne kamerabevægelser",
      "kw": "whip.?pan|kranoptagelse\\w*|hurtige? kamerabevægelse\\w*",
      "why": "kameraet skal føles som en dokumentarfotograf, ikke en actionfilm"
    },
    {
      "id": "r3",
      "text": "Intet skønhedslys",
      "kw": "skønhedslys|glamour\\w*|studielys",
      "why": "alt lys skal kunne findes på stedet"
    },
    {
      "id": "r4",
      "text": "Intet overspil",
      "kw": "overdrevet|overspil\\w*|grimasse\\w*",
      "why": "humoren kommer fra det underspillede"
    },
    {
      "id": "r5",
      "text": "Ingen kunstig baggrundsuskarphed",
      "kw": "bokeh|uskarp baggrund",
      "why": "dokumentarlook med dybdeskarphed"
    },
    {
      "id": "r6",
      "text": "Intet rent eller nyt tøj",
      "kw": "helt nyt|nystrøget|skinnende ren\\w*",
      "why": "håndværkertøj er slidt"
    },
    {
      "id": "r7",
      "text": "Ingen musik, medmindre den er bestilt",
      "kw": "musik\\w*|soundtrack",
      "why": "lyden er stedets egen"
    },
    {
      "id": "r8",
      "text": "Bevar dansk hverdagsrealisme",
      "kw": "",
      "why": "det genkendelige er pointen"
    }
