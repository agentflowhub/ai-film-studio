# Frontend (Vite) — offentlige værdier, sikre at bage ind i bundtet
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Edge Functions — sættes som Supabase secrets, ALDRIG i koden
# supabase secrets set ANTHROPIC_API_KEY=...
# Valgfri model-override pr. opgavetype, fx:
# FILM_MODEL_BRIEF_GENERATE=claude-opus-5

# Produktion (MVP 1)
# Hemmelig nøgle, som pg_cron sender til generation-worker (x-worker-secret)
# supabase secrets set WORKER_SECRET=...
# Simulator-provider, indtil rigtige billed-/videoprovidere er valgt.
# Virker aldrig, når APP_ENV=production.
# supabase secrets set ALLOW_SIMULATOR_PROVIDER=true
