# Frontend (Vite) — offentlige værdier, sikre at bage ind i bundtet
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Edge Functions — sættes som Supabase secrets, ALDRIG i koden
# supabase secrets set ANTHROPIC_API_KEY=...
# Valgfri model-override pr. opgavetype, fx:
# FILM_MODEL_BRIEF_GENERATE=claude-opus-5

# Produktion (MVP 1)
# Hemmelig nøgle, som pg_cron sender til generation-worker (x-worker-secret)
# supabase secrets set WORKER_SECRET=...
# Billeder: OpenAI (ChatGPT Images). Nøglen fra platform.openai.com.
# supabase secrets set OPENAI_API_KEY=...
# Video: Higgsfield. Formatet er KEY_ID:KEY_SECRET fra Higgsfields konsol.
# supabase secrets set HIGGSFIELD_CREDENTIALS=...
# Valgfrit: modellen, der styrer OpenAI-kaldet (billedet laves af billedmodellen)
# FILM_OPENAI_RESPONSES_MODEL=gpt-5.4-mini
# Valgfrit: pris i øre pr. generering, pr. model (grundlag for budgettet), fx
# FILM_PRICE_OPENAI_GPT_IMAGE_2_5_SUNBURST=300
# FILM_PRICE_HIGGSFIELD_DOP_STANDARD=600
# Simulator-provider til udvikling og test. Virker aldrig, når APP_ENV=production.
# supabase secrets set ALLOW_SIMULATOR_PROVIDER=true
